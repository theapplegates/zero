---
// Components
import SearchBar from "@/components/global/navigation/SearchBar.astro";
import ThemeToggle from "@/components/assets/ThemeToggle.astro";
// Assets
import Logo from "@/components/assets/Logo.astro";
const { fullWidth = false } = Astro.props;
const navigationButtons = [
  {
    title: "Buy Zeroindex",
    href: "https://buy.polar.sh/polar_cl_MOD8VbnH7TZZ58sMoFCNmoJeM1mV2DeU53Jsw1NBrY6",
  },
  {
    title: "Overview",
    href: "/system/overview",
  },
  {
    title: "Blog",
    href: "/blog/",
  },
  {
    title: "sign in",
    href: "/sign-in",
  },
];
---

<header
  class:list={[
    "fixed top-0 right-0 z-50 hidden w-auto lg:block bg-base-100 dark:bg-base-700",
    fullWidth ? "left-0" : "left-72",
  ]}
>
  <div
    class:list={[
      "flex items-center justify-between gap-4 lg:mt-1 lg:mr-1 border-t lg:border-r lg:rounded-tr-xl px-4 py-2.5 border-b border-base-200 dark:border-base-800 bg-white dark:bg-base-900",
      { "lg:ml-1 lg:border-l lg:rounded-tl-xl": fullWidth },
    ]}
  >
    {
      fullWidth && (
        <a
          href="/"
          class="flex items-center shrink-0 space-x-2 text-base-900 dark:text-white"
        >
          <Logo class="size-4" />
          <span class="text-lg font-semibold">ZeroIndex</span>
        </a>
      )
    }
    <div class="w-full max-w-48">
      <SearchBar searchId="desktop" />
    </div>
    <div class="flex flex-col ml-auto gap-2 md:gap-4 md:flex-row">
      {
        navigationButtons.map((Button, index) => (
          <a
            href={Button.href}
            class="text-2xl  md:text-sm hover:text-base-600 text-base-500 dark:text-base-400 dark:hover:text-base-200 transition-colors"
          >
            {Button.title}
          </a>
        ))
      }
    </div>
    <ThemeToggle />
  </div>
</header>
